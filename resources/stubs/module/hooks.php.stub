<?php

use App\Support\Hook;

// Ссылка в боковом меню
Hook::add('sidebarMenu', static function () {
    return '<li>
        <a class="menu-item' . (request()->is('{{ moduleRoute }}*') ? ' active' : '') . '" href="' . route('{{ moduleRoute }}.index') . '">
            <i class="menu-icon fas fa-puzzle-piece"></i>
            <span class="menu-label">' . __('{{ moduleKey }}::{{ moduleKey }}.title') . '</span>
        </a>
    </li>';
});
{{ adminHook }}
