DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect /index.php/... and /public/... To Clean URL If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} \s/+(?:index\.php|public)(?:/+([^?\s]*))?[?\s] [NC]
    RewriteRule ^ /%1 [L,R=301,NE]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Кэш статики. Сборка Vite (/build/) — с хэшем в имени, её кэшируем на год без перепроверки.
# Остальное (custom.css, аватары, загрузки) может смениться под тем же именем — на месяц
<IfModule mod_expires.c>
    <FilesMatch "\.(css|js|woff2?|ttf|ico|svg|jpe?g|png|gif|webp|avif|mp4|webm|mov|mp3|ogg)$">
        ExpiresActive On
        ExpiresDefault "access plus 1 month"

        <If "%{REQUEST_URI} =~ m#/build/#">
            ExpiresDefault "access plus 1 year"
        </If>
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|ico|svg|jpe?g|png|gif|webp|avif|mp4|webm|mov|mp3|ogg)$">
        Header set Cache-Control "public, max-age=2592000"

        <If "%{REQUEST_URI} =~ m#/build/#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>
</IfModule>

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
