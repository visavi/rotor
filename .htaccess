<IfModule mod_rewrite.c>
    RewriteEngine On

    RedirectMatch 403 ^/app/?$
    RedirectMatch 403 ^/bootstrap/?$
    RedirectMatch 403 ^/resources/?$
    RedirectMatch 403 ^/storage/?$
    RedirectMatch 403 ^/vendor/?$

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_URI} !^public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Скрытые файлы: .env, .git
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Служебные файлы — только точные имена: правило действует и на public,
# без якорей под него попадали test_cron.php и greenville.jpg
<FilesMatch "^(artisan|cron\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>
